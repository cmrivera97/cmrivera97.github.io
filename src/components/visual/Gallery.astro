---
import type { CollectionEntry } from 'astro:content';

import { getT, type Lang } from '../../i18n/getT';
import { hueFromSlug } from '../../utils/slug-hash';
import Placeholder from './Placeholder.astro';
import { withBase } from '../../utils/withBase';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = getT(lang);
const hue = hueFromSlug(project.data.slug);

type MediaSlide = { kind: 'image' | 'video'; key: string; src: string; alt: string };
type Slide =
  | MediaSlide
  | { kind: 'placeholder'; key: string; hue: number };

let slides: Slide[];
if (project.data.gallery.length > 0) {
  slides = project.data.gallery.map((item, i): Slide => ({
    kind: item.kind,
    key: `${project.data.slug}-${i}`,
    src: item.src,
    alt: item.alt[lang],
  }));
} else {
  slides = Array.from({ length: 5 }, (_, i) => ({
    kind: 'placeholder' as const,
    key: `${project.data.slug}-${i}`,
    hue: (hue + i * 24) % 360,
  }));
}
---
<div class="showcase gallery">
  <div
    class="showcase-track"
    data-carousel="loop"
    role="region"
    aria-roledescription="carousel"
    tabindex="0"
  >
    {slides.map((s) => (
      <div class="showcase-card" data-slug={s.key}>
        <div class="showcase-frame">
          <div class="showcase-screen">
            {s.kind === 'placeholder' && <Placeholder hue={s.hue} glyph="◆" />}
            {s.kind === 'image' && (
              <img src={withBase(s.src)} alt={s.alt} loading="lazy" decoding="async" />
            )}
            {s.kind === 'video' && (
              <video
                src={withBase(s.src)}
                autoplay muted loop playsinline preload="metadata"
                aria-label={s.alt}
              ></video>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="showcase-nav">
    <button
      type="button"
      class="btn btn-glass showcase-arrow"
      data-carousel-arrow="prev"
      data-no-splash
      data-cursor="link"
      aria-label={t('detail.prev')}
    >←</button>
    {slides.length > 1 && (
      <div class="showcase-dots" role="tablist" aria-label="Image">
        {slides.map((_, i) => (
          <button
            type="button"
            class:list={['showcase-dot', { active: i === 0 }]}
            data-dot
            data-index={i}
            data-no-splash
            data-cursor="link"
            aria-label={`${i + 1}`}
          ></button>
        ))}
      </div>
    )}
    <button
      type="button"
      class="btn btn-glass showcase-arrow"
      data-carousel-arrow="next"
      data-no-splash
      data-cursor="link"
      aria-label={t('detail.next')}
    >→</button>
  </div>
</div>

<div
  class="lightbox"
  data-lightbox
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label={project.data.title[lang]}
>
  <div class="lightbox-backdrop" data-lb-backdrop></div>
  <button
    type="button"
    class="lightbox-btn lightbox-close"
    data-lb-close
    data-no-splash
    data-cursor="link"
    aria-label={t('detail.close')}
  >×</button>
  <button
    type="button"
    class="lightbox-btn lightbox-prev"
    data-lb-prev
    data-no-splash
    data-cursor="link"
    aria-label={t('detail.prev')}
  >‹</button>
  <figure class="lightbox-figure">
    <div class="lightbox-media" data-lb-media></div>
    <figcaption class="lightbox-caption">
      <span data-lb-caption></span>
      <span class="lightbox-count" data-lb-count></span>
    </figcaption>
  </figure>
  <button
    type="button"
    class="lightbox-btn lightbox-next"
    data-lb-next
    data-no-splash
    data-cursor="link"
    aria-label={t('detail.next')}
  >›</button>
</div>

<script>
  import { initCarousel } from '../../scripts/carousel';
  import { initLightbox } from '../../scripts/lightbox';

  initCarousel();
  initLightbox();
</script>
